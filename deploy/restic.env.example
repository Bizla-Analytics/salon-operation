# Docker --env-file syntax: plain values, no shell quotes. Store outside Git.
# Use an HTTPS S3-compatible bucket on a DIFFERENT server/provider.
RESTIC_REPOSITORY=s3:https://storage.example.com/salonops-prod-backups
RESTIC_PASSWORD=replace-with-a-unique-backup-encryption-password
AWS_ACCESS_KEY_ID=replace-with-a-bucket-scoped-access-key
AWS_SECRET_ACCESS_KEY=replace-with-a-bucket-scoped-secret-key
AWS_DEFAULT_REGION=us-east-1
# Keep this encryption password in the company's password manager too.
