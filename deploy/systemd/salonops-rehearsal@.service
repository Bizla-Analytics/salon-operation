[Unit]
Description=Verify latest off-server SalonOps backup in isolation (%i)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=salonops-deploy
EnvironmentFile=/etc/salonops/%i.ops.env
ExecStart=/usr/bin/bash /opt/salonops-%i/scripts/rehearse_offsite.sh ${SALONOPS_ENV_FILE} ${SALONOPS_PROJECT} /opt/salonops-%i/compose.production.yaml ${SALONOPS_BACKUP_ROOT} ${SALONOPS_RESTIC_ENV_FILE}
ExecStart=/usr/bin/bash /opt/salonops-%i/scripts/restic_admin.sh ${SALONOPS_ENV_FILE} ${SALONOPS_PROJECT} /opt/salonops-%i/compose.production.yaml ${SALONOPS_BACKUP_ROOT} ${SALONOPS_RESTIC_ENV_FILE} prune
TimeoutStartSec=4h
UMask=0077
