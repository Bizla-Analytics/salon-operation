# Generate the REAL file at /etc/salonops/dev.env, outside Git, chmod 600.
# Only these three secrets are needed; all private-preview settings are fixed.
# Do not put production passwords or real customer data on this test server.
SECRET_KEY=replace-with-a-unique-random-secret-at-least-50-characters
POSTGRES_PASSWORD=replace-with-a-separate-random-app-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-random-bootstrap-password
# The workflow supplies SALONOPS_IMAGE. Standalone backup uses the saved release.
